# Gemini API key used by the Google GenAI client. Set this in Render's secret environment group.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Google AI API-key name accepted by the app; use only if GEMINI_API_KEY is not set.
GOOGLE_API_KEY=your_google_ai_api_key_here

# Directory for streamed uploads before extraction. The default is the operating system temp directory.
TEMP_STORAGE_DIR=/tmp/multimodal_agent

# Render provides this automatically; local Docker uses 8000 when it is unset.
PORT=8000

# Optional: absolute path to tesseract binary for Windows local development.
# Docker/Linux does NOT need this — tesseract-ocr is installed via apt-get.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
